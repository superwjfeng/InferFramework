{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug test_llm",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/test/test_llm",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/lib:${workspaceFolder}/build/_deps/sentencepiece-build/src:${env:LD_LIBRARY_PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build test_llm",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
